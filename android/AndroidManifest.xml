<?xml version="1.0" encoding="utf-8"?>
<!-- The tablet app: a full-screen WebView around the bundled dashboard
     (assets/www, copied from templates/ and static/ at build time) and the
     in-app updater. Version code and name come from the release tag
     (scripts/build-android.sh); minSdk 24, targetSdk 35. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.touchdashboard.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Haptic ticks on keys and fader detents (navigator.vibrate). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The Wi-Fi lock that keeps power save off while the app is in front (MainActivity). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Self-update through PackageInstaller; the user allows it once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup off: the pairing token must not leave the tablet in a cloud backup. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares a downloaded update with the package installer (read grant only). -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="dev.touchdashboard.app.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Reopens the app after an update it started itself (where Android allows). -->
        <receiver
            android:name=".PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
