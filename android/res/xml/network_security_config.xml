<?xml version="1.0" encoding="utf-8"?>
<!-- The PC serves the dashboard over plain HTTP/WebSocket on the LAN; updates
     come from GitHub over HTTPS with the system's trust store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
